{
  "semi": true,
  "trailingComma": "all",
  "singleQuote": true,
  "printWidth": 100,
  "tabWidth": 2,
  "bracketSpacing": true,
  "arrowParens": "always",
  "endOfLine": "lf",
  "plugins": ["@trivago/prettier-plugin-sort-imports"],
  "importOrder": [
    "^(node:)",
    "<THIRD_PARTY_MODULES>",
    "^@config/(.*)$",
    "^@config$",
    "^@constant/(.*)$",
    "^@constant$",
    "^@enum/(.*)$",
    "^@enum$",
    "^@type/(.*)$",
    "^@type$",
    "^@model/(.*)$",
    "^@model$",
    "^@query/(.*)$",
    "^@query$",
    "^@service/(.*)$",
    "^@service$",
    "^@controller/(.*)$",
    "^@controller$",
    "^@middleware/(.*)$",
    "^@middleware$",
    "^@route/(.*)$",
    "^@route$",
    "^@validator/(.*)$",
    "^@validator$",
    "^@util/(.*)$",
    "^@util$",
    "^@loader/(.*)$",
    "^@loader$",
    "^@logger/(.*)$",
    "^@logger$",
    "^@i18n/(.*)$",
    "^@i18n$",
    "^@resource/(.*)$",
    "^@resource$"
  ],
  "importOrderSeparation": true,
  "importOrderSortSpecifiers": true,
  "importOrderGroupNamespaceSpecifiers": true,
  "importOrderCaseInsensitive": true,
  "importOrderParserPlugins": ["typescript", "decorators-legacy", "jsx"]
}