{
  "name": "node-backend-toolkit",
  "version": "1.0.3",
  "type": "commonjs",
  "description": "A fully dynamic, multi-project reusable backend package for authentication, user management, roles, permissions, email, and storage.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "node-backend-toolkit": "./dist/cli/index.js"
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/goyanikrishna/npm-package.git"
  },
  "homepage": "https://github.com/goyanikrishna/npm-package#readme",
  "bugs": {
    "url": "https://github.com/goyanikrishna/npm-package/issues"
  },
  "author": "Krishna Goyani <goyanikrishna7478@gmail.com>",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "dev": "concurrently -k \"tsc -p tsconfig.build.json --watch\" \"tsc-alias -p tsconfig.build.json --watch\"",
    "start": "node dist/index.js",
    "prestart": "npm run build",
    "test": "jest --config jest.config.ts --forceExit --detectOpenHandles",
    "test:unit": "jest --config jest.config.ts --testPathPattern=tests/unit --forceExit",
    "test:integration": "jest --config jest.config.ts --testPathPattern=tests/integration --forceExit --detectOpenHandles",
    "test:coverage": "jest --config jest.config.ts --coverage --forceExit --detectOpenHandles",
    "test:ci": "npm run quality",
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" \"tests/**/*.ts\" --fix",
    "lint:strict": "eslint \"src/**/*.ts\" \"tests/**/*.ts\" --max-warnings 0",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" \"jest.config.ts\" \"eslint.config.mjs\" \"tsconfig*.json\" \"package.json\" \".prettierrc.json\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\" \"jest.config.ts\" \"eslint.config.mjs\" \"tsconfig*.json\" \"package.json\" \".prettierrc.json\"",
    "format:src": "prettier --write \"src/**/*.ts\"",
    "type-check": "tsc --noEmit -p tsconfig.json",
    "quality": "npm run lint:strict && npm run format:check && npm run type-check && npm test && npm run build",
    "clean": "rimraf dist",
    "prepublishOnly": "npm run quality",
    "typeorm": "typeorm-ts-node-commonjs -d src/database/cli-datasource.ts",
    "migration:generate": "typeorm-ts-node-commonjs migration:generate src/database/migrations/Migration -d src/database/cli-datasource.ts",
    "migration:create": "typeorm-ts-node-commonjs migration:create src/database/migrations/Migration",
    "migration:run": "ts-node src/database/run-migrations.ts",
    "migration:revert": "ts-node src/database/revert-migrations.ts",
    "db:seed": "ts-node src/database/seed.ts",
    "prepare": "husky"
  },
  "keywords": [
    "backend",
    "authentication",
    "authorization",
    "user-management",
    "multi-tenant",
    "typeorm",
    "express",
    "jwt",
    "roles",
    "permissions",
    "email",
    "storage",
    "s3",
    "r2"
  ],
  "peerDependencies": {
    "@aws-sdk/client-s3": "^3.0.0",
    "@aws-sdk/s3-request-presigner": "^3.0.0",
    "express": "^4.18.0 || ^5.0.0",
    "pg": "^8.0.0",
    "reflect-metadata": "^0.1.13 || ^0.2.0",
    "resend": "^6.0.0",
    "typeorm": "^0.3.20"
  },
  "peerDependenciesMeta": {
    "resend": {
      "optional": true
    },
    "@aws-sdk/client-s3": {
      "optional": true
    },
    "@aws-sdk/s3-request-presigner": {
      "optional": true
    }
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "handlebars": "^4.7.9",
    "joi": "^17.13.4",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^9.0.3",
    "typeorm-naming-strategies": "^4.1.0"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1058.0",
    "@aws-sdk/s3-request-presigner": "^3.1075.0",
    "@eslint/js": "^10.0.1",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^18.19.0",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.11.0",
    "@types/supertest": "^6.0.2",
    "concurrently": "^9.2.5",
    "eslint": "^10.14.0",
    "express": "^4.18.2",
    "express-validation": "^4.1.1",
    "globals": "^17.14.0",
    "jest": "^29.7.0",
    "pg": "^8.11.3",
    "prettier": "^3.9.10",
    "reflect-metadata": "^0.2.1",
    "resend": "^6.12.4",
    "rimraf": "^6.0.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.1.4",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.9.10",
    "tsconfig-paths": "^4.2.0",
    "typeorm": "^0.3.20",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1"
  }
}
