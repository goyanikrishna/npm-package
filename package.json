{
  "name": "node-backend-toolkit",
  "version": "1.0.1",
  "description": "A fully dynamic, multi-project reusable backend package for authentication, user management, roles, permissions, email, and storage.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "node-backend-toolkit": "./dist/cli/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/goyanikrishna/npm-package.git"
  },
  "homepage": "https://github.com/goyanikrishna/npm-package#readme",
  "bugs": {
    "url": "https://github.com/goyanikrishna/npm-package/issues"
  },
  "author": "Krishna Goyani <goyanikrishna7478@gmail.com>",
  "license": "MIT",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "test": "jest --config jest.config.ts --forceExit --detectOpenHandles",
    "test:unit": "jest --config jest.config.ts --testPathPattern=tests/unit --forceExit",
    "test:integration": "jest --config jest.config.ts --testPathPattern=tests/integration --forceExit --detectOpenHandles",
    "test:coverage": "jest --config jest.config.ts --coverage --forceExit --detectOpenHandles",
    "lint": "eslint \"src/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" --fix",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "type-check": "tsc --noEmit",
    "clean": "rimraf dist",
    "prepublishOnly": "npm run build && npm run test"
  },
  "keywords": [
    "backend",
    "authentication",
    "authorization",
    "user-management",
    "multi-tenant",
    "typeorm",
    "express",
    "jwt",
    "roles",
    "permissions",
    "email",
    "storage",
    "s3",
    "r2"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "peerDependencies": {
    "express": "^4.18.0 || ^5.0.0",
    "pg": "^8.0.0",
    "reflect-metadata": "^0.1.13 || ^0.2.0",
    "typeorm": "^0.3.20"
  },
  "peerDependenciesMeta": {
    "resend": {
      "optional": true
    },
    "@aws-sdk/client-s3": {
      "optional": true
    },
    "@aws-sdk/s3-request-presigner": {
      "optional": true
    }
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "handlebars": "^4.7.9",
    "joi": "^17.13.4",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^9.0.3",
    "typeorm-naming-strategies": "^4.1.0"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1058.0",
    "@aws-sdk/s3-request-presigner": "^3.1075.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.14.0",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.11.0",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "eslint": "^8.57.0",
    "express": "^4.18.2",
    "express-validation": "^4.1.1",
    "jest": "^29.7.0",
    "pg": "^8.11.3",
    "prettier": "^3.2.5",
    "reflect-metadata": "^0.2.1",
    "resend": "^6.12.4",
    "rimraf": "^6.0.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.1.4",
    "ts-node": "^10.9.2",
    "typeorm": "^0.3.20",
    "typescript": "^5.5.0"
  }
}
